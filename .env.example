# Supabase project URL and publishable key. Both are shipped to the browser;
# row level security is what actually protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# Server and scripts only. Bypasses row level security; never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_placeholder

# Mapbox public token (pk.*). URL-restrict it in Mapbox once deployed.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.placeholder
