# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# kei-interactive-harness: never commit these
.env
.env.local
.env.*.local
.env.production
.env.development
*.harness-new
semgrep-nightly.json
outdated.json
knip.json
ratchet-trend.txt
.claude/settings.local.json
.harness/shots/

!.env.example

# Takeout exports: our private notes, never committed
/imports/

# impeccable, the design skill, is installed per machine (npx impeccable
# install, project scope), not vendored: its browser script would trip CI's
# security scan. The hooks in .claude/settings.json do nothing without it.
/.claude/skills/impeccable/
/.claude/agents/impeccable-*.md

# impeccable working files: hook cache, per-machine config, the decision
# page's state, decision sketches and review screenshots. The shared config,
# design sidecar and surface briefs are committed.
/.impeccable/hook.cache.json
/.impeccable/config.local.json
/.impeccable/questions/
/.impeccable/mocks/
/.impeccable/review/
